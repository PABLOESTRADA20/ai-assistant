generator client {
  provider        = "prisma-client"
  output          = "../app/generated/prisma"
  runtime         = "cloudflare"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model Conversation {
  id        String    @id @default(uuid())
  title     String    @default("Nueva conversación")
  model     String    @default("openai/gpt-oss-120b")
  summary   String?
  /// Nº de mensajes iniciales ya plegados en `summary` (compactación incremental).
  summarizedCount Int @default(0)
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  model          String?
  tools          Json?
  /// Fuentes del cerebro que ARIA usó para la respuesta (chips, FASE 3).
  sources        Json?
  /// Contexto estimado del turno: presupuesto/tokens/compactación (FASE 3).
  context        Json?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model VaultNote {
  path      String @id
  name      String
  title     String?
  content   String
  embedding Unsupported("vector(1024)")?
  updatedAt DateTime @updatedAt
}

model Memory {
  id           String   @id @default(uuid())
  type         String
  category     String
  content      String
  importance   Float    @default(0.5)
  confidence   Float    @default(0.5)
  tags         Json?
  source       String   @default("conversation")
  isCompressed Boolean  @default(false)
  embedding    Unsupported("vector(1024)")?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([type])
  @@index([category])
  @@index([isCompressed, updatedAt])
}

model SessionContext {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model EmbeddingCache {
  hash      String                                @id
  embedding Unsupported("vector(1024)")
  createdAt DateTime                              @default(now())
  usedAt    DateTime                              @default(now())

  @@index([usedAt])
}

model SystemPrompt {
  id        String   @id @default(uuid())
  role      String
  content   String
  model     String?
  tools     Json?
  createdAt DateTime @default(now())
}

/// "Carpeta ARIA": notas guardadas en la nube para luego exportarlas a Obsidian.
/// Vive en la base de datos a propósito: el Worker no puede escribir en el disco
/// del PC, y así la carpeta está disponible igual desde el celular y el PC.
model Note {
  id        String   @id @default(uuid())
  title     String
  content   String
  tags      Json?
  source    String   @default("aria")
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

/// Trozo de código indexado por significado (FASE 3).
///
/// Lo llena `scripts/index-code.ts` desde la PC (donde está el repo clonado);
/// el Worker solo consulta con `search_code` y no puede leer el disco.
///
/// `fileHash` es el hash del fichero COMPLETO: si no cambió, el script cambió
/// solo ese fichero y no gasta ni una llamada de embeddings (aceptación de la
/// FASE 3: segunda ejecución sin cambios = cero llamadas).
model CodeChunk {
  id          String   @id @default(uuid())
  /// `owner/repo`, o `local` si no se declaró `CODE_INDEX_REPO`.
  repo        String
  /// Ruta relativa al raíz indexado, siempre con `/`.
  path        String
  /// Nombre de la función/clase/constante cuando el troceado lo detectó.
  symbol      String?
  kind        String
  lang        String?
  startLine   Int
  endLine     Int
  content     String
  /// Hash del texto del trozo (fino, para comparar dentro de un fichero).
  contentHash String
  /// Hash del fichero entero: la puerta que salta lo que no cambió.
  fileHash    String
  embedding   Unsupported("vector(1024)")?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([repo, path])
  @@index([fileHash])
  @@index([kind])
}
