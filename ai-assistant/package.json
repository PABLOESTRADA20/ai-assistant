{
  "name": "ai-assistant",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:reindex": "node --import ./scripts/wasm-module-hook.mjs --import tsx --import ./scripts/register-pg-adapter.mjs scripts/reindex.ts",
    "db:smoke": "node --import ./scripts/wasm-module-hook.mjs --import tsx --import ./scripts/register-pg-adapter.mjs scripts/smoke-memory.ts",
    "db:brain": "node --import ./scripts/wasm-module-hook.mjs --import tsx --import ./scripts/register-pg-adapter.mjs scripts/smoke-brain.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:psql": "docker compose exec postgres psql -U postgres -d aria",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "node scripts/test-migrate.mjs && vitest run tests/integration",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "agent": "node local-agent/aria-local-agent.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "lint": "next lint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "@prisma/adapter-neon": "6.19.0",
    "@prisma/adapter-pg": "^6.19.0",
    "@prisma/client": "6.19.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.436.0",
    "react": "^18",
    "react-dom": "^18",
    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "^15.5.0",
    "remark-gfm": "^4.0.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "^15.5.19",
    "next": "^15.5.19",
    "postcss": "^8",
    "prisma": "6.19.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.3",
    "wrangler": "4.130.0"
  }
}
