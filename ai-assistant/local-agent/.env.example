# Configuración del agente local de ARIA.
# Copia este archivo a `.env` (mismo directorio) y ajusta los valores.

# Puerto local donde escucha el agente. Si lo cambias, define también
# NEXT_PUBLIC_ARIA_LOCAL_AGENT=http://127.0.0.1:PUERTO en la app web. Esa URL
# no es un secreto: puede vivir en el bundle del cliente.
ARIA_AGENT_PORT=8787

# Token que exige el agente. OPCIONAL: si no lo defines, el agente genera uno
# la primera vez y lo guarda en `.aria-local-token` (lo imprime en consola).
# El usuario lo pega UNA vez en la app web y queda en el localStorage del
# navegador.
#
# NO uses una variable NEXT_PUBLIC_* para el token: termina inlineada en el
# bundle público y cualquiera podría abrir apps en tu PC.
# ARIA_LOCAL_TOKEN=cambia-esto-por-un-token-largo

# Orígenes extra permitidos por CORS (separados por coma). Por defecto ya se
# permiten localhost, 127.0.0.1 y *.workers.dev.
# ARIA_ALLOWED_ORIGINS=https://mi-dominio.com

# Permite comandos sueltos que resuelve el PATH, además del mapa de apps, las
# rutas existentes no ejecutables y las URIs permitidas. NO permite abrir
# ejecutables por ruta ni saltarse las reglas de argumentos/consolas.
# Actívalo si quieres que ARIA pueda abrir programas que no estén en el mapa
# (p. ej. "mi-juego" si está en el PATH).
# ARIA_ALLOW_ANY=1
