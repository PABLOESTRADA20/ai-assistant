# Configuración del agente local de ARIA.
# Copia este archivo a `.env` (mismo directorio) y ajusta los valores.

# Puerto local donde escucha el agente. Si lo cambias, define también
# NEXT_PUBLIC_ARIA_LOCAL_AGENT=http://127.0.0.1:PUERTO en la app web.
ARIA_AGENT_PORT=8787

# Token compartido con la app web. Define el MISMO valor aquí y en
# NEXT_PUBLIC_ARIA_LOCAL_TOKEN (en .env.local / secrets del Worker).
# Sin token, cualquiera que alcance el puerto puede abrir apps.
ARIA_LOCAL_TOKEN=cambia-esto-por-un-token-largo

# Orígenes extra permitidos por CORS (separados por coma). Por defecto ya se
# permite localhost y *.workers.dev.
# ARIA_ALLOWED_ORIGINS=https://mi-dominio.com

# Permite abrir CUALQUIER ejecutable/comando, no solo el mapa de apps, rutas
# existentes y URIs. Actívalo si quieres que ARIA pueda abrir programas que no
# estén en el mapa (p. ej. "mi-juego.exe").
# ARIA_ALLOW_ANY=1
