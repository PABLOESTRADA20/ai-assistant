DATABASE_URL=
DATABASE_URL_UNPOOLED=
GROQ_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
VAULT_PATH=C:\ruta\a\tu\vault-de-obsidian
# Obligatoria en produccion (el preview de OpenNext es un build de produccion:
# sin esta clave la app falla cerrada).
ARIA_ACCESS_TOKEN=
# OAuth de un solo usuario (FASE 7). Para que aparezca un botón hace falta
# cliente + secreto + identidad permitida; si falta algo, ese proveedor no se ofrece.
# La sesión se firma con ARIA_SESSION_SECRET (o, si no hay, con ARIA_ACCESS_TOKEN).
ARIA_SESSION_SECRET=
ARIA_SESSION_TTL_SECONDS=604800
# URL pública exacta del callback. Si se deja vacía se usa el origen de la petición;
# en producción conviene fijarla para no depender de la cabecera Host.
ARIA_OAUTH_REDIRECT_BASE=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_ALLOWED_LOGIN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_ALLOWED_EMAIL=
# GitHub es lectura por defecto. Para crear ramas (nombre libre) y PRs,
# configura un token fine-grained de escritura y cambia explícitamente el
# interruptor.
GITHUB_TOKEN=
GITHUB_WRITE_ENABLED=false
# Auto-fusión (FASE 7): con true, ARIA puede fusionar el PR ella misma, pero
# SOLO si las pruebas (CI) pasaron. Va aparte de GITHUB_WRITE_ENABLED a propósito.
GITHUB_AUTO_MERGE=false

# GitLab (FASE 7 Parte B). También funciona por URL o gitlab:grupo/proyecto.
GITLAB_TOKEN=
GITLAB_WRITE_ENABLED=false
GITLAB_AUTO_MERGE=false

# Bitbucket (reconocido pero no implementado todavía)
BITBUCKET_TOKEN=

# WhatsApp Cloud API (opcional; si lo configuras, APP_SECRET es obligatorio)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Lista blanca opcional: solo filtra números, no autentica.
WHATSAPP_ALLOWED_NUMBERS=
