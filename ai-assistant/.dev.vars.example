DATABASE_URL=
DATABASE_URL_UNPOOLED=
GROQ_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
VAULT_PATH=C:\ruta\a\tu\vault-de-obsidian
# Obligatoria en produccion (el preview de OpenNext es un build de produccion:
# sin esta clave la app falla cerrada).
ARIA_ACCESS_TOKEN=
# GitHub es lectura por defecto. Para crear ramas (nombre libre) y PRs,
# configura un token fine-grained de escritura y cambia explícitamente el
# interruptor.
GITHUB_TOKEN=
GITHUB_WRITE_ENABLED=false
# Auto-fusión (FASE 7): con true, ARIA puede fusionar el PR ella misma, pero
# SOLO si las pruebas (CI) pasaron. Va aparte de GITHUB_WRITE_ENABLED a propósito.
GITHUB_AUTO_MERGE=false

# GitLab (FASE 7 Parte B). También funciona por URL o gitlab:grupo/proyecto.
GITLAB_TOKEN=
GITLAB_WRITE_ENABLED=false
GITLAB_AUTO_MERGE=false

# Bitbucket (reconocido pero no implementado todavía)
BITBUCKET_TOKEN=
